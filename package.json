{
  "name": "ohmy-ai-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:setup": "tsx database/migrate-and-seed.ts",
    "db:seed": "tsx database/migrate-and-seed.ts",
    "db:reset": "node -e \"require('fs').rmSync('.pgdata',{recursive:true,force:true});console.log('local database removed')\" && npm run db:setup",
    "db:inspect": "tsx scripts/inspect-data.ts",
    "dev:test": "node scripts/dev-with-test-login.mjs",
    "test:routes": "tsx scripts/smoke.ts",
    "test:rbac": "tsx scripts/rbac-test.ts",
    "test": "npm run test:routes && npm run test:rbac",
    "check": "npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.8",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
