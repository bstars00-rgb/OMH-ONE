{
  "name": "OHMY ONE",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "postCreateCommand": "npm ci && npm run db:setup",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "OHMY ONE",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode", "bradlc.vscode-tailwindcss"]
    }
  },
  "remoteEnv": {
    "AUTH_SECRET": "codespaces-development-secret",
    "DB_DRIVER": "pglite",
    "AI_PROVIDER": "mock"
  }
}
